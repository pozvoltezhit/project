      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Query 5xx / completed HTTP requests",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(knowledge_http_requests_total{route=~\"/query.*\",status_class=\"5xx\"}[5m])) / (sum(rate(knowledge_http_requests_total{route=~\"/query.*\"}[5m])) > 0)"
